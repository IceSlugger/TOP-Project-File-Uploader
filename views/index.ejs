<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - File Vault</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1>📁 File Vault</h1>
    <div>
      <span>Welcome, <strong><%= currentUser.name || currentUser.email %></strong></span>
      <a href="/logout" class="btn btn-danger" style="margin-left: 10px;">Logout</a>
    </div>
  </header>

  <div class="controls">
    <!-- Create Folder -->
    <form action="/folders" method="POST">
      <input type="text" name="name" placeholder="New Folder Name" required />
      <button type="submit" class="btn">+ New Folder</button>
    </form>

    <!-- Upload Single File -->
    <form action="/upload" method="POST" enctype="multipart/form-data">
      <input type="file" name="file" required />
      <button type="submit" class="btn btn-success">Upload File</button>
    </form>

    <!-- Upload Entire Folder -->
    <form action="/upload-folder" method="POST" enctype="multipart/form-data">
      <input type="file" name="files" webkitdirectory directory multiple required />
      <button type="submit" class="btn btn-success">Upload Folder</button>
    </form>
  </div>

  <!-- Folders Section -->
  <div class="section">
    <h2>Folders</h2>
    <% if (folders && folders.length > 0) { %>
      <div class="grid">
        <% folders.forEach(folder => { %>
          <div class="card">
            <a href="/folders/<%= folder.id %>">📁 <%= folder.name %></a>
            <form action="/folders/<%= folder.id %>/delete" method="POST" style="margin-top: 10px;">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>No folders created yet.</p>
    <% } %>
  </div>

  <!-- Root Files Section -->
  <div class="section">
    <h2>Root Files</h2>
    <% if (files && files.length > 0) { %>
      <div class="file-list">
        <% files.forEach(file => { %>
          <div class="file-item">
            <div>
              <a href="<%= file.url %>" target="_blank">📄 <%= file.name %></a>
              <span style="font-size: 12px; color: #64748b; margin-left: 8px;">
                (<%= (file.size / 1024).toFixed(1) %> KB)
              </span>
            </div>
            <form action="/files/<%= file.id %>/delete" method="POST">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>No files uploaded in root directory.</p>
    <% } %>
  </div>
</body>
</html>