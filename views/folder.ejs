<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= folder.name %> - File Vault</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1>📁 <%= folder.name %></h1>
    <div>
      <a href="/" class="btn">← Back to Dashboard</a>
      <a href="/logout" class="btn btn-danger" style="margin-left: 10px;">Logout</a>
    </div>
  </header>

  <div class="controls">
    <!-- Upload Single File into this folder -->
    <form action="/upload" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="folderId" value="<%= folder.id %>" />
      <input type="file" name="file" required />
      <button type="submit" class="btn btn-success">Upload File to Folder</button>
    </form>
  </div>

  <div class="section">
    <h2>Files inside <%= folder.name %></h2>
    <% if (folder.files && folder.files.length > 0) { %>
      <div class="file-list">
        <% folder.files.forEach(file => { %>
          <div class="file-item">
            <div>
              <a href="<%= file.url %>" target="_blank">📄 <%= file.name %></a>
              <span style="font-size: 12px; color: #64748b; margin-left: 8px;">
                (<%= (file.size / 1024).toFixed(1) %> KB)
              </span>
            </div>
            <form action="/files/<%= file.id %>/delete" method="POST">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>This folder is currently empty.</p>
    <% } %>
  </div>
</body>
</html>